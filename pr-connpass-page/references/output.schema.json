{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pr-connpass-page output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "sections",
    "html",
    "imageSlots",
    "surveyQuestions",
    "participantOnlyInfo",
    "skinSource",
    "notes"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "html"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "html": {
            "type": "string"
          }
        }
      }
    },
    "html": {
      "type": "string"
    },
    "imageSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "surveyQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "answerType",
          "required",
          "options"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "answerType": {
            "type": "string",
            "enum": [
              "free_text",
              "checkbox",
              "radio",
              "dropdown"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "participantOnlyInfo": {
      "type": "string"
    },
    "skinSource": {
      "type": "string",
      "enum": [
        "brief",
        "brand-guide",
        "gdg-design"
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
