{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "connpass page skin",
  "type": "object",
  "required": ["name", "bg", "panelBg", "keyline", "accent", "text"],
  "properties": {
    "name": {
      "type": "string"
    },
    "bg": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "panelBg": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "keyline": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "accent": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      },
      "minItems": 1
    },
    "text": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "sticker": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
