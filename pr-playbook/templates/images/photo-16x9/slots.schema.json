{
  "templateId": "photo-16x9",
  "size": {
    "width": 1600,
    "height": 900
  },
  "purpose": "写真を下地にした投稿・広告",
  "slots": {
    "photoUrl": {
      "type": "url",
      "required": true
    },
    "headline": {
      "type": "text",
      "required": true,
      "maxLength": 36
    },
    "sub": {
      "type": "text",
      "required": false,
      "maxLength": 60
    }
  },
  "layoutVars": {
    "titleScale": {
      "min": 0.8,
      "max": 1.2,
      "default": 1
    },
    "align": {
      "enum": ["left", "center"],
      "default": "left"
    },
    "emphasis": {
      "maxItems": 3
    }
  }
}
