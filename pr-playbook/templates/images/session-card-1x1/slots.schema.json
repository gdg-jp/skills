{
  "templateId": "session-card-1x1",
  "size": {
    "width": 1080,
    "height": 1080
  },
  "purpose": "セッション紹介",
  "slots": {
    "sessionTitle": {
      "type": "text",
      "required": true,
      "maxLength": 60
    },
    "speakerName": {
      "type": "text",
      "required": true,
      "maxLength": 30
    },
    "speakerRole": {
      "type": "text",
      "required": true,
      "maxLength": 60
    },
    "speakerImageUrl": {
      "type": "url",
      "required": true
    },
    "track": {
      "type": "text",
      "required": false,
      "maxLength": 20
    },
    "time": {
      "type": "text",
      "required": false,
      "maxLength": 12
    }
  },
  "layoutVars": {
    "titleScale": {
      "min": 0.8,
      "max": 1.2,
      "default": 1
    },
    "align": {
      "enum": ["left", "center"],
      "default": "left"
    },
    "emphasis": {
      "maxItems": 3
    }
  }
}
