{
  "templateId": "ig-story-9x16",
  "size": {
    "width": 1080,
    "height": 1920
  },
  "purpose": "Instagram ストーリー",
  "slots": {
    "eventName": {
      "type": "text",
      "required": false,
      "maxLength": 40
    },
    "headline": {
      "type": "text",
      "required": true,
      "maxLength": 40
    },
    "sub": {
      "type": "text",
      "required": false,
      "maxLength": 80
    },
    "date": {
      "type": "text",
      "required": false,
      "maxLength": 30
    },
    "place": {
      "type": "text",
      "required": false,
      "maxLength": 40
    },
    "cta": {
      "type": "text",
      "required": true,
      "maxLength": 20
    }
  },
  "layoutVars": {
    "titleScale": {
      "min": 0.8,
      "max": 1.2,
      "default": 1
    },
    "align": {
      "enum": ["left", "center"],
      "default": "left"
    },
    "emphasis": {
      "maxItems": 3
    }
  }
}
