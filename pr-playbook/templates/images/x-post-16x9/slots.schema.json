{
  "templateId": "x-post-16x9",
  "size": {
    "width": 1600,
    "height": 900
  },
  "purpose": "X 投稿画像（横）",
  "slots": {
    "eventName": {
      "type": "text",
      "required": false,
      "maxLength": 40
    },
    "headline": {
      "type": "text",
      "required": true,
      "maxLength": 40
    },
    "sub": {
      "type": "text",
      "required": false,
      "maxLength": 80
    },
    "date": {
      "type": "text",
      "required": false,
      "maxLength": 30
    },
    "place": {
      "type": "text",
      "required": false,
      "maxLength": 40
    }
  },
  "layoutVars": {
    "titleScale": {
      "min": 0.8,
      "max": 1.2,
      "default": 1
    },
    "align": {
      "enum": ["left", "center"],
      "default": "left"
    },
    "emphasis": {
      "maxItems": 3
    }
  }
}
