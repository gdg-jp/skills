{
  "version": 1,
  "x": {
    "foldThreshold": {
      "weighted": 280,
      "provisional": true,
      "note": "X の重み付き文字数（CJK は 2、ASCII は 1、URL は 23）。ユーザーの観察値で更新する"
    },
    "urlWeight": 23,
    "postWindows": {
      "weekday": [["17:00", "19:30"]],
      "weekend": [["12:00", "13:30"], ["17:00", "19:30"]],
      "provisional": true
    },
    "followIntentPattern": "^https://(x|twitter)\\.com/intent/(follow|user)\\?"
  },
  "mail": {
    "sendWindows": [["06:00", "07:30"], ["16:30", "18:00"]],
    "provisional": true,
    "maxBodyLines": 12,
    "provisional_maxBodyLines": true,
    "bannedPhrases": ["させていただきます", "ご確認のほど", "何卒"],
    "decorationChars": [
      "━",
      "─",
      "■",
      "□",
      "◆",
      "◇",
      "▼",
      "▶",
      "★",
      "☆",
      "✨",
      "📣",
      "👇",
      "【",
      "＼",
      "／"
    ]
  },
  "reminders": {
    "staffOffsetMinutes": 60,
    "speakerOffsetMinutes": 180,
    "provisional_speaker": true,
    "templates": {
      "staff": "{{mention}} {{at}} に X で投稿します。いいね・リポストお願いします！\n{{headline}}\n{{url}}",
      "story": "{{mention}} {{at}} の投稿の画像を、各自の Instagram ストーリーに上げてください。\n{{image}}\n{{url}}",
      "review": "{{mention}} 下書き「{{title}}」のレビューをお願いします。\n{{url}}",
      "followup": "{{mention}} 「{{title}}」の依頼にまだ返事がありません。もう一度連絡してください。\n{{url}}",
      "delegated": "{{mention}} {{account}} での投稿をお願いします（{{at}}）。\n{{text}}",
      "discordPost": "{{text}}",
      "linkBroken": "リンク切れ: {{target}} が {{status}} を返しています（{{campaign}}）\n{{url}}",
      "approvalDue": "{{mention}} 「{{title}}」は {{at}} の予定ですが、まだ承認されていません。\n{{url}}",
      "digest": "おはようございます。{{campaign}} の今日の予定と返事待ちです。\n{{today}}\n{{waiting}}\n{{url}}"
    },
    "provisional_templates": true
  },
  "budget": {
    "nonAdsMaxYen": 10000,
    "nonAdsToleranceRatio": 0.5,
    "xIgRatioRange": [[3, 7], [4, 6]],
    "bands": [100000, 300000, 500000],
    "overrunAlertRatio": 0.1,
    "provisional_overrunAlertRatio": true
  },
  "milestonesDaysBefore": [45, 21, 7],
  "milestoneToleranceDays": 2,
  "ads": {
    "x": {
      "startDaysBefore": [10, 14],
      "impressionDays": 3
    },
    "meta": {
      "startDaysBefore": 10,
      "toleranceDays": 1
    }
  },
  "connpass": {
    "titleMinChars": 20,
    "provisional_titleMinChars": true,
    "summaryMaxLines": 3,
    "summaryMaxCharsPerLine": 60,
    "placeWords": [
      "Kansai",
      "Kwansai",
      "Osaka",
      "Kobe",
      "Kyoto",
      "Tokyo",
      "Japan",
      "in",
      "関西",
      "大阪",
      "神戸",
      "京都",
      "東京"
    ]
  },
  "instagram": {
    "minHashtags": 5,
    "provisional_minHashtags": true
  },
  "flyer": {
    "versions": ["v1", "v2"],
    "v2SessionConfirmedRatio": 0.5
  },
  "swag": {
    "kinds": ["all", "referral", "lottery", "redeem", "survey"]
  },
  "officialSeriesNames": [
    "Google I/O Extended",
    "I/O Extended",
    "Build with AI",
    "DevFest Kansai",
    "DevFest",
    "GDG",
    "Google Developer Groups"
  ],
  "channelCatalog": [
    "x_organic",
    "x_ads",
    "ig_organic",
    "ig_ads",
    "flyer_distribute",
    "flyer_post",
    "other_event_lt",
    "other_event_flyer",
    "other_event_attend",
    "gdg_discord",
    "org_outreach",
    "friends",
    "community_ask",
    "speaker_invite",
    "novelty",
    "segment_content"
  ],
  "channelLabels": {
    "x_organic": "X（投稿）",
    "x_ads": "X（広告）",
    "ig_organic": "Instagram（投稿）",
    "ig_ads": "Instagram（広告）",
    "flyer_distribute": "チラシ（配布）",
    "flyer_post": "チラシ（掲示）",
    "other_event_lt": "他イベントの LT",
    "other_event_flyer": "他イベントでのチラシ",
    "other_event_attend": "他イベントで知り合った",
    "gdg_discord": "GDG の Discord",
    "org_outreach": "学校・会社からの案内",
    "friends": "知人・友人",
    "community_ask": "コミュニティ・サークル",
    "speaker_invite": "登壇者の告知",
    "novelty": "ノベルティ",
    "segment_content": "企画"
  },
  "surveyQuestions": ["年齢", "職業", "経験年数", "イベントを知った場所"],
  "surveySourceQuestion": "イベントを知った場所",
  "surveyExtraOptions": ["その他"],
  "render": {
    "thumbnailScale": 0.25,
    "minFontPxAtThumbnail": 9,
    "minContrast": 4.5,
    "provisional_thumbnailScale": true,
    "provisional_minFontPxAtThumbnail": true,
    "minContrastLarge": 3,
    "note": "minContrast は本文、minContrastLarge は WCAG の大きい文字（24px か太字 18.66px 以上）。縮小表示の文字サイズは仮値"
  },
  "images": {
    "connpassThumbnail": {
      "width": 1200,
      "height": 630,
      "maxBytes": 1048576,
      "provisional": true,
      "note": "connpass のイベント画像の推奨比率は未確認（事前確認 4）。1 MB 上限は apps/connpass の実装値"
    },
    "jpegQualityStart": 85,
    "jpegQualityStep": 10,
    "jpegQualityMin": 60
  },
  "live": {
    "flagNotes": {
      "noRecording": "⚠️ 録画・撮影 NG",
      "english": "🌐 英語セッション",
      "onsiteOnly": "📍 現地のみ",
      "bringPc": "💻 PC をご用意ください"
    },
    "streamPrefix": "📺 配信はこちら",
    "trackEmoji": ["🔵", "🟢", "🟡", "🔴"],
    "photoAfterMinutes": 10,
    "templates": {
      "session": "{{emoji}}{{time}}〜 {{track}}\n『{{title}}』\n👤{{speakers}}\n{{flags}}\n{{stream}}\n{{hashtag}}",
      "opening": "{{time}} オープニングが始まります！\n{{event}}\n{{stream}}\n{{hashtag}}",
      "doors": "{{time}} 開場しました！受付でお名前をお伝えください。\n{{hashtag}}",
      "closing": "{{time}} クロージングです。ご参加ありがとうございました！\n{{hashtag}}"
    },
    "provisional_templates": true
  },
  "design": {
    "fontsBase": "https://pr.gdgs.jp/fonts",
    "fonts": [
      {
        "family": "Google Sans Flex",
        "file": "GoogleSansFlex.ttf",
        "license": "OFL",
        "use": "英数字の見出しと本文（可変: wght 100〜1000）"
      },
      {
        "family": "LINE Seed JP",
        "file": "LINESeedJP-Regular.ttf",
        "license": "OFL",
        "use": "日本語の本文"
      },
      {
        "family": "LINE Seed JP",
        "file": "LINESeedJP-Bold.ttf",
        "license": "OFL",
        "use": "日本語の見出し"
      },
      {
        "family": "LINE Seed JP",
        "file": "LINESeedJP-ExtraBold.ttf",
        "license": "OFL",
        "use": "日本語の大見出し"
      },
      {
        "family": "Google Sans Code",
        "file": "GoogleSansCode.ttf",
        "license": "OFL",
        "use": "等幅（コード、プロモーションコード）"
      }
    ],
    "allowedImageHosts": ["img.gdgs.jp", "pr.gdgs.jp"],
    "safeInset": 32,
    "referenceImagesPerJob": 6,
    "maxRevisions": 3,
    "directions": {
      "min": 2,
      "max": 3
    },
    "note": "Tips 38〜50（guides/design.md）。参考画像は pr の「デザインの参考」から新しい順に添付する"
  }
}
