 }\n  .notch img[data-logo] { height: 86px; width: auto; }\n  .wordmark { font: 400 29px/1.1 \"Google Sans Flex\", sans-serif; letter-spacing: -0.02em; margin: 0; }\n  .asterisk { position: absolute; left: 803px; top: 315px; width: 135px; }\n</style>\n<div class=\"canvas\" data-safe-inset=\"32\" style=\"width:1600px;height:900px;\">\n  <div class=\"lockup\">\n    <svg class=\"brace\" viewBox=\"0 0 120 420\" aria-hidden=\"true\"><path d=\"M100 14 H78 Q48 14 48 44 V170 Q48 210 14 210 Q48 210 48 250 V376 Q48 406 78 406 H100\" fill=\"none\" stroke=\"#1E1E1E\" stroke-width=\"40\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><path d=\"M100 14 H78 Q48 14 48 44 V170 Q48 210 14 210 Q48 210 48 250 V376 Q48 406 78 406 H100\" fill=\"none\" stroke=\"#C3ECF6\" stroke-width=\"30\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/></svg>\n    <div>\n      <p class=\"name\" data-slot=\"eventName\" data-required=\"true\">DevFest Kansai</p>\n      <div class=\"rule\"></div>\n      <p class=\"sub\" data-slot=\"sub\">AI時代の「<b>考える</b>」を取り戻す。<br><b>異分野</b>と<b>越境</b>のAIカンファレンス</p>\n      <div class=\"punct\">\n        <img src=\"assets/stickers/28-double-slash-outline.svg\" alt=\"\" style=\"height:44px;\">\n        <img src=\"assets/stickers/40-globe-outline.svg\" alt=\"\" style=\"height:44px;\">\n      </div>\n    </div>\n    <svg class=\"brace\" viewBox=\"0 0 120 420\" aria-hidden=\"true\" style=\"transform:scaleX(-1)\"><path d=\"M100 14 H78 Q48 14 48 44 V170 Q48 210 14 210 Q48 210 48 250 V376 Q48 406 78 406 H100\" fill=\"none\" stroke=\"#1E1E1E\" stroke-width=\"40\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><path d=\"M100 14 H78 Q48 14 48 44 V170 Q48 210 14 210 Q48 210 48 250 V376 Q48 406 78 406 H100\" fill=\"none\" stroke=\"#58CAFF\" stroke-width=\"30\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/></svg>\n  </div>\n  <span class=\"tag\" data-slot=\"track\">ハンズオン</span>\n  <p class=\"title\" data-slot=\"sessionTitle\" data-required=\"true\">Antigravityで<br>AIエージェントを作ってみよう</p>\n  <p class=\"speaker\" data-slot=\"speakerName\" data-required=\"true\">Haren Bhandari</p>\n  <p class=\"role\" data-slot=\"speakerRole\" data-required=\"true\">Developer Relations Engineer, Google Cloud Japan</p>\n  <img class=\"asterisk\" src=\"assets/stickers/27-asterisk-outline.svg\" alt=\"\">\n  <div class=\"photo\">\n    <!-- 本番では assets/photos/<speakerId>.jpg を <img> で置く -->\n    <div class=\"notch\">\n      <img data-logo src=\"assets/gdg.svg\" alt=\"GDG\">\n      <p class=\"wordmark\">Google<br>Developer<br>Groups</p>\n    </div>\n  </div>\n</div>\n",
