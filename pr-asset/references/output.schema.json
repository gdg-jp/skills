              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
