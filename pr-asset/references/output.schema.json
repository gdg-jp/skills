{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pr-asset output",
  "description": "Generated by pr-playbook/scripts/render/build-schema.mjs from templates/images/*/slots.schema.json. mode=design: html (and kit, or directions for purpose=kit); mode=template: slots and layoutVars. Unused keys are null. Do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "templateId",
    "html",
    "kit",
    "directions",
    "slots",
    "layoutVars",
    "skinSource",
    "rationaleMd",
    "selfReviewMd"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["design", "template"]
    },
    "templateId": {
      "type": "string",
      "enum": [
        "connpass-thumbnail",
        "ig-feed-4x5",
        "ig-story-9x16",
        "live-session-16x9",
        "ogp-1200x630",
        "photo-16x9",
        "session-card-16x9",
        "session-card-1x1",
        "speaker-card-1x1",
        "x-ad-16x9",
        "x-post-16x9",
        "x-post-1x1"
      ]
    },
    "html": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kit": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["feel", "why", "palette", "fonts", "lockup", "motifs", "photo", "facts"],
          "properties": {
            "feel": {
              "type": "string"
            },
            "why": {
              "type": "string"
            },
            "palette": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dominant", "ground", "panel", "ink", "keyline", "emphasis", "extra"],
              "properties": {
                "dominant": {
                  "type": "string"
                },
                "ground": {
                  "type": "string"
                },
                "panel": {
                  "type": "string"
                },
                "ink": {
                  "type": "string"
                },
                "keyline": {
                  "type": "string"
                },
                "emphasis": {
                  "type": "string"
                },
                "extra": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "fonts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading", "headingJa", "body"],
              "properties": {
                "heading": {
                  "type": "string"
                },
                "headingJa": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            },
            "lockup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "text", "sub", "notes"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["braces", "logo-image", "official", "text"]
                },
                "text": {
                  "type": "string"
                },
                "sub": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              }
            },
            "motifs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "photo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["shape", "keyline", "notes"],
              "properties": {
                "shape": {
                  "type": "string"
                },
                "keyline": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              }
            },
            "facts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dateStyle", "venueStyle", "badges"],
              "properties": {
                "dateStyle": {
                  "type": "string"
                },
                "venueStyle": {
                  "type": "string"
                },
                "badges": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "directions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "html", "rationaleMd", "kit"],
            "properties": {
              "label": {
                "type": "string"
              },
              "html": {
                "type": "string"
              },
              "rationaleMd": {
                "type": "string"
              },
              "kit": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "feel",
                  "why",
                  "palette",
                  "fonts",
                  "lockup",
                  "motifs",
                  "photo",
                  "facts"
