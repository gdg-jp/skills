                "properties": {
                  "feel": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  },
                  "palette": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "dominant",
                      "ground",
                      "panel",
                      "ink",
                      "keyline",
                      "emphasis",
                      "extra"
                    ],
                    "properties": {
                      "dominant": {
                        "type": "string"
                      },
                      "ground": {
                        "type": "string"
                      },
                      "panel": {
                        "type": "string"
                      },
                      "ink": {
                        "type": "string"
                      },
                      "keyline": {
                        "type": "string"
                      },
                      "emphasis": {
                        "type": "string"
                      },
                      "extra": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "fonts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["heading", "headingJa", "body"],
                    "properties": {
                      "heading": {
                        "type": "string"
                      },
                      "headingJa": {
                        "type": "string"
                      },
                      "body": {
                        "type": "string"
                      }
                    }
                  },
                  "lockup": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "text", "sub", "notes"],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": ["braces", "logo-image", "official", "text"]
                      },
                      "text": {
                        "type": "string"
                      },
                      "sub": {
                        "type": "string"
                      },
                      "notes": {
                        "type": "string"
                      }
                    }
                  },
                  "motifs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "photo": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["shape", "keyline", "notes"],
                    "properties": {
                      "shape": {
                        "type": "string"
                      },
                      "keyline": {
                        "type": "string"
                      },
                      "notes": {
                        "type": "string"
                      }
                    }
                  },
                  "facts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["dateStyle", "venueStyle", "badges"],
                    "properties": {
                      "dateStyle": {
                        "type": "string"
                      },
                      "venueStyle": {
                        "type": "string"
                      },
                      "badges": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
