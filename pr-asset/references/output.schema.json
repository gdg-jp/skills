    "layoutVars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titleScale", "align", "emphasis"],
      "properties": {
        "titleScale": {
          "type": "number"
        },
        "align": {
          "type": "string",
          "enum": ["left", "center"]
        },
        "emphasis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "skinSource": {
      "type": "string",
      "enum": ["brief", "brand-guide", "gdg-design", "kit"]
    },
    "rationaleMd": {
      "type": "string"
    },
    "selfReviewMd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
