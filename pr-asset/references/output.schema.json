{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pr-asset output",
  "description": "Generated by pr-playbook/scripts/render/build-schema.mjs from templates/images/*/slots.schema.json. Slots the template does not use are null. Do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["templateId", "slots", "layoutVars", "skinSource", "rationaleMd"],
  "properties": {
    "templateId": {
      "type": "string",
      "enum": [
        "connpass-thumbnail",
        "ig-feed-4x5",
        "ig-story-9x16",
        "live-session-16x9",
        "ogp-1200x630",
        "photo-16x9",
        "session-card-1x1",
        "speaker-card-1x1",
        "x-ad-16x9",
        "x-post-16x9",
        "x-post-1x1"
      ]
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cta",
        "date",
        "eventName",
        "flags",
        "headline",
        "photoUrl",
        "place",
        "sessionTitle",
        "speakerImageUrl",
        "speakerName",
        "speakerRole",
        "sub",
        "subcopy",
        "time",
        "title",
        "track"
      ],
      "properties": {
        "cta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "photoUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionTitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "speakerImageUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "speakerName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "speakerRole": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "subcopy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "track": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "layoutVars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titleScale", "align", "emphasis"],
      "properties": {
        "titleScale": {
          "type": "number"
        },
        "align": {
          "type": "string",
          "enum": ["left", "center"]
        },
        "emphasis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "skinSource": {
      "type": "string",
      "enum": ["brief", "brand-guide", "gdg-design"]
    },
    "rationaleMd": {
      "type": "string"
    }
  }
}
